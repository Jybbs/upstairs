{
  "name": "upstairs",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Shows the satellites passing over a chosen spot on a topographic map.",
  "homepage": "https://upstairs.fyi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jybbs/upstairs"
  },
  "keywords": [
    "celestrak",
    "maplibre",
    "rust",
    "satellite",
    "satellite-tracking",
    "sgp4",
    "typescript",
    "vitepress",
    "webassembly"
  ],
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/averia-serif-libre": "5.3.0",
    "@vueuse/core": "15.0.0",
    "katex": "0.19.1",
    "maplibre-contour": "0.1.1",
    "maplibre-gl": "6.16.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/culori": "4.0.1",
    "@types/fontkit": "2.0.9",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vscode/markdown-it-katex": "1.1.2",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "culori": "4.0.2",
    "fontkit": "2.0.4",
    "happy-dom": "21.0.4",
    "knip": "6.44.2",
    "oxlint": "1.92.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-static-copy": "4.1.1",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "woff2-encoder": "2.0.0",
    "wrangler": "4.160.0"
  },
  "overrides": {
    "glob": "14.0.4",
    "katex": "0.19.1",
    "minimatch": "11.0.6"
  },
  "knip": {
    "entry": [
      ".vitepress/catalog/fetch.ts",
      ".vitepress/catalog/service.ts",
      ".vitepress/lib/site/*.data.ts",
      ".vitepress/preview/functions/*.ts",
      ".vitepress/tools/*.ts"
    ],
    "ignoreBinaries": [
      "mise"
    ],
    "ignoreDependencies": [
      "oxlint",
      "vue-tsc",
      "wrangler"
    ],
    "typescript": {
      "config": [
        ".vitepress/catalog/tsconfig.json",
        ".vitepress/tsconfig.json"
      ]
    },
    "vitest": {
      "config": [
        ".vitepress/vitest.config.ts"
      ]
    }
  }
}
