{
  "name": "upstairs-catalog",
  "main": "service.ts",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "upstairs.fyi/catalog.bin", "zone_name": "upstairs.fyi" }
  ],
  "triggers": { "crons": ["0 */2 * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "REFRESHER", "class_name": "Refresher" },
      { "name": "RELAYS", "class_name": "Relay" }
    ]
  },
  "exports": {
    "Refresher": { "type": "durable-object", "storage": "sqlite" },
    "Relay": { "type": "durable-object", "storage": "sqlite" }
  },
  "kv_namespaces": [{ "binding": "CATALOG" }],
  "observability": { "enabled": true, "issues": { "enabled": true } }
}
