{
  "name": "upstairs",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Shows the satellites passing over a chosen spot on a topographic map.",
  "homepage": "https://upstairs.fyi",
  "keywords": [
    "celestrak",
    "maplibre",
    "rust",
    "satellite",
    "satellite-tracking",
    "sgp4",
    "typescript",
    "vitepress",
    "webassembly"
  ],
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "maplibre-contour": "0.1.1",
    "maplibre-gl": "6.16.0",
    "satellite.js": "7.1.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/culori": "4.0.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/tsconfig": "0.9.1",
    "culori": "4.0.2",
    "knip": "6.44.2",
    "oxlint": "1.92.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "knip": {
    "entry": [
      "catalog/fetch.ts",
      "catalog/service.ts",
      "tools/*.ts"
    ],
    "ignoreDependencies": [
      "oxlint",
      "vue-tsc"
    ],
    "typescript": {
      "config": [
        "catalog/tsconfig.json",
        "tsconfig.json"
      ]
    }
  }
}
