#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Install the packages `bun.lock` resolves, failing where the lockfile would change, unless the packages are present and neither `package.json` nor `bun.lock` changed since the last install that passed"
#MISE outputs     = ["node_modules/.site-install"]
#MISE sources     = ["bun.lock", "package.json"]

bun install --frozen-lockfile
touch node_modules/.site-install
