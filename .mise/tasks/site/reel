#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "reel"
#MISE depends     = ["crate:compile", "site:install"]
#MISE description = "Record the README's preview of the home map from the committed fixture catalog into `.github/`, one GIF per scheme"
#MISE dir         = "{{config_root}}/docs"

common=$(git rev-parse --path-format=absolute --git-common-dir)
export PLAYWRIGHT_BROWSERS_PATH="${common%/*}/.cache/playwright"

bun x playwright install --no-shell chromium
bun run --bun .vitepress/tools/reel.ts
