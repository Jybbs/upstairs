#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "links"
#MISE depends     = ["site:press"]
#MISE description = "Check every link, asset, and heading fragment in the pressed site against the files the build wrote"
#MISE dir         = "{{config_root}}/docs"

lychee \
  --include-fragments \
  --index-files index.html \
  --no-progress \
  --offline \
  --root-dir "$PWD/.vitepress/dist" \
  "$@" \
  .vitepress/dist
