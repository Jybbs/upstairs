#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "advisories"
#MISE description = "Fail on an advisory against a package `docs/bun.lock` resolves, or on an advisory, license, version, or source `rust/.cargo/deny.toml` denies for a crate `rust/Cargo.lock` resolves"

bun audit --cwd docs "$@"
cargo deny --manifest-path rust/Cargo.toml check
