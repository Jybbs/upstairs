#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Delete every tool cache on `main` a newer one of the same tool set and platform has replaced"

gh cache list \
  --jq '
    group_by(.key
      | (capture("^provision-(?<set>.+)-mise-v[0-9]+-(?<platform>.+?)-[0-9.]+-")
        | [.set, .platform])
      // [.])
    | map(sort_by(.createdAt) | .[:-1][])
    | .[].id
  ' \
  --json createdAt,id,key \
  --key provision- \
  --limit 100 \
  --ref refs/heads/main \
  | xargs -r -n 1 gh cache delete
