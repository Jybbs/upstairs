#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "compile"
#MISE description = "Compile the orbit crate to WebAssembly and write its bindings into `rust/pkg/`"

cargo build \
  --locked \
  --manifest-path rust/Cargo.toml \
  --release \
  --target wasm32-unknown-unknown
wasm-bindgen \
  --out-dir rust/pkg \
  --target web \
  "$CARGO_TARGET_DIR/wasm32-unknown-unknown/release/orbit.wasm"
